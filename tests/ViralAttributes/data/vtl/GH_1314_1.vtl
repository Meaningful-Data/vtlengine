define viral propagation VP_1 (variable At_1) is
    aggregate sum
end viral propagation;
DS_r1 <- if DS_1 = 1.0 then DS_2 else (if DS_1 = 2.0 then DS_3 else DS_4);
DS_r2 <- case when DS_1 = 1.0 then (case when DS_1 = 2.0 then DS_3 else DS_4) else DS_2;
DS_r3 <- if DS_5 > 2 then DS_5 else DS_6;
DS_r4 <- case when DS_5 > 2 then DS_5 else DS_6;
DS_r5 <- DS_5 + DS_6;
DS_r6 <- inner_join(DS_5 as A, DS_6 as B calc Me_2 := A#Me_1 + B#Me_1 drop A#Me_1, B#Me_1);
DS_r7 <- case when DS_5 > 3 then DS_5 when DS_5 > 2 then DS_6 else DS_7;
DS_r8 <- inner_join((if DS_8 < 10 then DS_8 else DS_8 * 2) as a, DS_9 as b keep a#Me_1);
DS_r9 <- (case when DS_8 < 10 then DS_8 else DS_8 * 2) + DS_9;
