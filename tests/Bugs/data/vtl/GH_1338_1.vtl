define datapoint ruleset dpr_cty ( valuedomain VD_CTY as C ) is
    r1 : when C = "DE" then false errorcode "DE_found"
end datapoint ruleset;

define datapoint ruleset dpr_nope ( valuedomain VD_NOPE as C ) is
    r1 : when C = "DE" then false errorcode "DE_found"
end datapoint ruleset;

define datapoint ruleset dpr_two ( valuedomain VD_CTY as C , VD_INT as I ) is
    r1 : when C = "DE" then I > 1 errorcode "DE_low"
end datapoint ruleset;

DS_r <- check_datapoint ( DS_1 , dpr_cty all );
