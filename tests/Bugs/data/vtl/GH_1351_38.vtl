define operator f ( x integer )
    returns integer is
        x
end operator;
define operator g ( x integer )
    returns string is
        cast ( x , string )
end operator;
SC_r <- f ( 4 / 2 );
DS_r <- DS_2 [ calc Me_2 := cast ( SC_r , string ) , Me_3 := cast ( f ( 2.0 ) , string ) , Me_4 := g ( 4 / 2 ) , Me_5 := f ( 4 / 2 ) ];
