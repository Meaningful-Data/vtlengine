define hierarchical ruleset HR_1 (variable rule Id_2) is
    R1: A = B + C
end hierarchical ruleset;

define datapoint ruleset DPR_1 (variable Me_1) is
    R1: Me_1 > 0 errorcode "E1";
    R2: Me_1 < 100 errorcode "E2"
end datapoint ruleset;

define operator f_hierarchy (ds dataset) returns dataset is
    hierarchy(ds, HR_1 rule Id_2)
end operator;

DS_r1 <- union(symdiff(DS_1, DS_3), DS_2);
DS_r2 <- setdiff(f_hierarchy(DS_1), DS_2);
DS_r3 <- intersect(check_datapoint(DS_1[filter Id_1 > 0], DPR_1 all), check_datapoint(DS_2, DPR_1 all));
