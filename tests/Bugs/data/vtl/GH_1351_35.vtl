define operator f ( s component < string > , k number )
    returns component < string > is
        substr ( s , 1 , k )
end operator;
define operator g ( s component < string > , k number )
    returns component < integer > is
        instr ( s , "c" , k )
end operator;
DS_r <- DS_1 [ calc Me_2 := f ( Me_1 , 3 ) , Me_3 := g ( Me_1 , 2 ) ];
