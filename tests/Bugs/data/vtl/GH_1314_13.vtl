DS_r1 <- DS_1[calc Me_3 := Me_2 = Me_1];
DS_r2 <- DS_2 = "true";
DS_r3 <- DS_3 = true;
DS_r4 <- DS_3 <> DS_2;
DS_r5 <- nvl(DS_2, "none");
DS_r6 <- DS_2[calc Me_2 := nvl(Me_1, "none"), Me_3 := Me_1 in {"true", "x"}, Me_4 := match_characters(Me_1, "t.*")];
DS_r7 <- DS_2[calc Me_2 := if Me_1 then true else false][calc Me_3 := Me_2 = "false"];
DS_r8 <- DS_2 in {"true", "x"};
