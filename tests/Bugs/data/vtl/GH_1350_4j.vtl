define datapoint ruleset DPR_1 ( valuedomain VD_2 as X ) is
    r1 : X > 1 errorcode "E1"
end datapoint ruleset;

DS_r1 <- check_datapoint ( DS_1 [ calc Me_5 := nvl ( Me_1 , SC_1 ) ] ,
                           DPR_1 components Me_5 invalid );
DS_r2 <- check_datapoint ( DS_1 [ calc Me_6 := SC_1 ] , DPR_1 components Me_6 invalid );
