DS_r <- DS_1 [ calc m1 := lag(Me_1 over (partition by Id_2 order by Id_1)),
                    m2 := lead(Me_1 over (partition by Id_2 order by Id_1)),
                    m3 := lag(Id_1, 1 over (partition by Id_2 order by Id_1)),
                    m4 := lead(Id_1, 1 over (partition by Id_2 order by Id_1)) ];
