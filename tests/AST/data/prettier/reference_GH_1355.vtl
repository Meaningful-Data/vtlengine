DS_r <-
	DS_1
		[calc Me_9 := sum(
			'Me#1' over(partition by 'Id#1')
		)];
DS_s <-
	DS_1
		[calc Me_9 := sum(
			'Me#1' over(partition by Id_2 order by 'Id#1' desc)
		)];
DS_t <-
	inner_join(
		DS_1 as A,
		DS_2 as B
		 calc Me_9 := sum(
			B#Me_2 over(partition by A#Id_2 order by A#'Me#1')
		)
	);
DS_u <-
	inner_join(
		DS_1 as A,
		DS_2 as B
		 rename A#Me_1 to Me_9, 'Me#2' to Me_8
	);
