define hierarchical ruleset HR_1(
	variable
	condition Id_1 as A_1
	rule Id_3) is
			when
				A_1 > 1995
			then
				EU = BE + FR
end hierarchical ruleset;

define hierarchical ruleset HR_2(
	valuedomain
	condition Id_1 as A_1, Id_2
	rule Id_3) is
			when
				A_1 > 1995 and Id_2 = "S1"
			then
				EU = BE + FR
end hierarchical ruleset;

DS_r1 <-
	check_hierarchy(
		DS_1,
		HR_1
		condition Id_1
		rule Id_3 all);
DS_r2 <-
	hierarchy(
		DS_1,
		HR_2
		condition Id_1, Id_2
		rule Id_3);
