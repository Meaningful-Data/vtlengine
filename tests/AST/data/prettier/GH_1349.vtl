DS_r <- check(DS_1 > 1 errorcode 100 errorlevel "1" invalid);
DS_s <- check(DS_1 > 1 errorcode "100" errorlevel 1 invalid);
define datapoint ruleset DPR_1 (variable Me_1) is R1: Me_1 > 0 errorcode 1.5 errorlevel true; R2: Me_1 > 1 errorcode "100" errorlevel 2 end datapoint ruleset;
define hierarchical ruleset HR_1 (variable rule Id_2) is R1: A = B + C errorcode 200 errorlevel "2" end hierarchical ruleset;
