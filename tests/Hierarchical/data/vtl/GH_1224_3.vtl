define hierarchical ruleset HR_1 (variable condition Me_1 rule Id_2) is
    R1: A = B [Me_1 > 0] + C errorcode "E1" errorlevel 1
end hierarchical ruleset;

DS_r1 <- hierarchy(DS_1, HR_1 condition Me_1 rule Id_2 always_null);
DS_r2 <- check_hierarchy(DS_1, HR_1 condition Me_1 rule Id_2 always_null all);
