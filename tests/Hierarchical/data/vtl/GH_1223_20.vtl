define hierarchical ruleset HR_1 (variable condition Id_1, At_1 rule Id_2) is
    R1: when Id_1 > 1 then Y = A + D [At_1 = "x"] errorcode "E1" errorlevel 1
end hierarchical ruleset;

DS_r1 <- hierarchy(DS_1, HR_1 condition Id_1, At_1 rule Id_2 partial_null);
DS_r2 <- check_hierarchy(DS_1, HR_1 condition Id_1, At_1 rule Id_2 partial_null all);
