define hierarchical ruleset HR_1 (variable rule Id_2) is
    R1: A = B + C errorcode "E1" errorlevel 1
end hierarchical ruleset;

DS_r1 <- hierarchy(DS_1, HR_1 rule Id_2 all);
DS_r2 <- hierarchy(DS_1, HR_1 rule Id_2 dataset all)[calc attribute At_1 := "z"];
DS_r3 <- hierarchy(DS_1, HR_1 rule Id_2 always_zero rule_priority all)[calc attribute At_1 := "z"];
