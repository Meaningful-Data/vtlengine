define hierarchical ruleset HR_1 ( variable rule Id_2 ) is
    R1 : A = B + C errorcode "E1"
    ; R2 : C = D + E errorcode "E2"
    ; R3 : B >= D errorcode "E3"
    ; R4 : E > X errorcode "E4"
    ; R5 : Y < Z errorcode "E5"
    ; R6 : D <= X errorcode "E6"
    ; R7 : F > B errorcode "E7"
end hierarchical ruleset;

DS_r := check_hierarchy ( DS_1, HR_1 partial_zero dataset all );
