define hierarchical ruleset HR_1 ( valuedomain rule VD_1 ) is
    A = J + K + L
    ; B = M + N + O
    ; C = P + Q
    ; D = R + S
    ; E = T + U + V
    ; F = Y + W + Z
    ; G = B + C
    ; H = D + E
    ; I = D + G
end hierarchical ruleset;

define viral propagation VP_1 ( variable At_1 ) is
    when null then null;
    when "Ay" then "Ay";
    when "Bq" then "Bq";
    when "Dx" then "Dx";
    when "Ko" then "Ko";
    when "Nj" then "Nj";
    when "Pz" then "Pz"
end viral propagation;

DS_r := hierarchy ( DS_1, HR_1 rule Id_2 partial_null );
